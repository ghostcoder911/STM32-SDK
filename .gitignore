# 1. Build Directories (Crucial for CMake and STM32CubeIDE)
build/
Debug/
Release/

# 2. GCC Compiled objects & dependencies
*.o
*.out
*.a
*.su    # Stack usage files generated by GCC
*.d     # Dependency files generated by GCC

# 3. Embedded Systems Outputs (AVR / STM32)
*.hex
*.elf
*.bin
*.map
*.lst

# 4. IDE and OS specific files
.DS_Store
.vscode/

# 5. STM32CubeIDE / Eclipse specific
.metadata/
.extSettings
*.launch
# Note: .project and .cproject are NOT ignored by default here. 
# Only ignore them if you do not want to share CubeIDE project settings.

# 6. C/C++ Windows Executables & Build Files (MSVC)
*.exe
*.obj
*.pdb
*.ilk
*.idb
*.dll
*.lib